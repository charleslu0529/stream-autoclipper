# Store text as LF in the repo and check it out as LF on every OS
* text=auto eol=lf

# Windows-only scripts need CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files: never touch line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.mp4  binary
*.mkv  binary
*.wav  binary
